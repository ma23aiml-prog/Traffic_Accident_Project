# ── Database configuration ──────────────────────────────────
# Set DB_TYPE to "sqlite" (default) or "postgres"
DB_TYPE=sqlite

# SQLite database file path (used when DB_TYPE=sqlite)
SQLITE_PATH=data/traffic_accidents.db

# PostgreSQL connection (used when DB_TYPE=postgres)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=traffic_accidents
# POSTGRES_USER=your_user
# POSTGRES_PASSWORD=your_password

# ── API configuration ───────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MODEL_PATH=models/severity_model.pkl
